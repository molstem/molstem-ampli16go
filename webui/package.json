{
  "name": "molstem-app",
  "version": "1.0.0-pre",
  "type": "module",
  "description": "molstem thermocycler web app (app.molstem.com)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:embed": "tsc && vite build --config vite.config.embed.ts && node scripts/gzip-assets.js",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.molstem.app",
    "productName": "molstem thermocycler",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dir",
      "icon": "icon.png"
    },
    "linux": {
      "target": "dir",
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.19",
    "@mui/material": "^5.15.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uplot": "^1.6.32",
    "uplot-react": "^1.2.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.0.0",
    "terser": "^5.46.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.12",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
