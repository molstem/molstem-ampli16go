# molstem thermocycler ESP32-C5 configuration defaults (ESP-IDF v6.0.2)
# After changing this file, run: idf.py fullclean && idf.py build
#
# Note: on the ESP32-C5 the second stage bootloader lives at 0x2000, not 0x0.
# The partition table stays at the default 0x8000, so partitions.csv is unchanged.

CONFIG_IDF_TARGET="esp32c5"

CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_WS_SUPPORT=y
# ESP-IDF v6.0 stopped invoking the URI handler for the WebSocket handshake
# (httpd_uri.c: "If the request is websocket handshake, then do not call the
# uri->handler"). These callbacks are the replacement mechanism and are the only
# way left to see the handshake - without them the socket fd is never captured
# and no frame can ever be sent to a client.
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# CPU frequency (240 MHz is the ESP32-C5 maximum, as 160 was on the C3)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Use USB Serial/JTAG for console (frees UART0 for MCU communication)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Certificate bundle for server verification (Cloudflare uses public CAs)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Cloudflare serves molstem.com with GTS Root R4 cross-signed by the retired GlobalSign Root CA;
# without this the bundle verifier only checks the chain's top issuer and fails with
# "no matching root certificate found".
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Enable ECDSA for device signing
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y

# WebSocket client
CONFIG_ESP_WEBSOCKET_CLIENT_ENABLE=y
