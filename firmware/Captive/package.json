{
  "name": "molstem-captive-portal",
  "version": "1.0.0",
  "description": "molstem thermocycler setup captive portal",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "concurrently \"npm run mock\" \"npm run dev\"",
    "dev:hw": "cross-env VITE_API_TARGET=http://192.168.4.1 vite",
    "build": "tsc && vite build",
    "build:embed": "tsc && vite build --config vite.config.embed.ts && node scripts/gzip-assets.js",
    "preview": "vite preview",
    "mock": "tsx server/mock-server.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "express": "^4.18.0",
    "jsdom": "^24.0.0",
    "terser": "^5.46.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^1.4.0"
  }
}
