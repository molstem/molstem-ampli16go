{
  "name": "@molstem/cloud-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "molstem cloud worker: serves app.molstem.com (web UI + cloud API) and devices.molstem.com",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate": "wrangler d1 execute molstem --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute molstem --local --file=./schema.sql"
  },
  "dependencies": {
    "@molstem/cloud-shared": "file:../shared",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.4.5",
    "wrangler": "^4.0.0"
  }
}
